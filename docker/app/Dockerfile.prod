# syntax=docker/dockerfile:1
FROM php:8.3-fpm-alpine AS base

# Install system dependencies
RUN apk add --no-cache \
    git curl zip unzip bash icu-dev oniguruma-dev libpng-dev libjpeg-turbo-dev libwebp-dev libzip-dev \
    libxml2-dev freetype-dev libjpeg-turbo libpng libwebp \
    ffmpeg

# Configure and install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) gd exif pcntl bcmath intl pdo pdo_mysql pdo_pgsql zip opcache

# Install Composer
ENV COMPOSER_HOME=/usr/local/composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Copy PHP configuration
COPY ./../php/php.ini /usr/local/etc/php/conf.d/custom.ini

# Production PHP-FPM configuration
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.interned_strings_buffer=16" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.fast_shutdown=1" >> /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www/html

# Build stage for dependencies
FROM base AS builder

# Copy composer files
COPY composer.json composer.lock ./

# Install PHP dependencies (production only)
RUN composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist

# Copy package files
COPY package.json package-lock.json ./

# Install Node.js for build
RUN apk add --no-cache nodejs npm

# Install npm dependencies
RUN npm ci --only=production=false

# Copy application files
COPY . .

# Build frontend assets
RUN npm run build

# Production stage
FROM base AS production

# Copy built dependencies from builder
COPY --from=builder /var/www/html/vendor ./vendor
COPY --from=builder /var/www/html/public/build ./public/build
COPY --from=builder /var/www/html/node_modules ./node_modules

# Copy application files
COPY . .

# Set proper permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html \
    && chmod -R 775 /var/www/html/storage \
    && chmod -R 775 /var/www/html/bootstrap/cache

# Switch to non-root user
USER www-data

# Default command
CMD ["php-fpm"]

