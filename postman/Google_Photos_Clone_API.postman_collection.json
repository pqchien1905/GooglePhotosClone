{
  "info": {
    "name": "Google Photos Clone API",
    "description": "API Collection for Google Photos Clone - Laravel Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        }
      ]
    },
    {
      "name": "Photos",
      "item": [
        {
          "name": "List Photos",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{baseUrl}}/photos?page=1&search=",
              "host": ["{{baseUrl}}"],
              "path": ["photos"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "search", "value": ""}
              ]
            }
          }
        },
        {
          "name": "Upload Photo",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "file", "type": "file", "src": ""}
              ]
            },
            "url": "{{baseUrl}}/photos"
          }
        },
        {
          "name": "Get Photo",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/photos/1"
          }
        },
        {
          "name": "Delete Photo (Soft)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/photos/1"
          }
        },
        {
          "name": "Toggle Favorite",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/photos/1/favorite"
          }
        },
        {
          "name": "Get Favorites",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/photos/favorites"
          }
        },
        {
          "name": "Get Trash",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/photos/trash"
          }
        },
        {
          "name": "Restore Photo",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/photos/1/restore"
          }
        },
        {
          "name": "Force Delete Photo",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/photos/1/force-delete"
          }
        },
        {
          "name": "Download Photo",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/photos/1/download"
          }
        }
      ]
    },
    {
      "name": "Videos",
      "item": [
        {
          "name": "List Videos",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/videos"
          }
        },
        {
          "name": "Upload Video",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "file", "type": "file", "src": ""}
              ]
            },
            "url": "{{baseUrl}}/videos"
          }
        },
        {
          "name": "Get Video",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/videos/1"
          }
        },
        {
          "name": "Delete Video",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/videos/1"
          }
        },
        {
          "name": "Toggle Video Favorite",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/videos/1/favorite"
          }
        }
      ]
    },
    {
      "name": "Albums",
      "item": [
        {
          "name": "List Albums",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/albums"
          }
        },
        {
          "name": "Create Album",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Album\",\n  \"photo_ids\": []\n}"
            },
            "url": "{{baseUrl}}/albums"
          }
        },
        {
          "name": "Get Album",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/albums/1"
          }
        },
        {
          "name": "Update Album",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Album Name\"\n}"
            },
            "url": "{{baseUrl}}/albums/1"
          }
        },
        {
          "name": "Delete Album",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/albums/1"
          }
        },
        {
          "name": "Add Photos to Album",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photo_ids\": [1, 2, 3]\n}"
            },
            "url": "{{baseUrl}}/albums/1/photos"
          }
        },
        {
          "name": "Remove Photos from Album",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photo_ids\": [1, 2]\n}"
            },
            "url": "{{baseUrl}}/albums/1/photos"
          }
        },
        {
          "name": "Set Album Cover",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photo_id\": 1\n}"
            },
            "url": "{{baseUrl}}/albums/1/cover"
          }
        }
      ]
    },
    {
      "name": "Friends",
      "item": [
        {
          "name": "List Friends",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/friends"
          }
        },
        {
          "name": "Get Friend Requests",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/friends/requests"
          }
        },
        {
          "name": "Get Sent Requests",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/friends/sent"
          }
        },
        {
          "name": "Send Friend Request",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"friend@example.com\"\n}"
            },
            "url": "{{baseUrl}}/friends/request"
          }
        },
        {
          "name": "Accept Friend Request",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/friends/requests/1/accept"
          }
        },
        {
          "name": "Reject Friend Request",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/friends/requests/1/reject"
          }
        },
        {
          "name": "Cancel Sent Request",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/friends/requests/1"
          }
        },
        {
          "name": "Remove Friend",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/friends/1"
          }
        },
        {
          "name": "Block User",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/friends/1/block"
          }
        }
      ]
    },
    {
      "name": "Shares",
      "item": [
        {
          "name": "Shared By Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/shares/by-me"
          }
        },
        {
          "name": "Shared With Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/shares/with-me"
          }
        },
        {
          "name": "Share with Friends",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"friend_ids\": [1],\n  \"photo_ids\": [1, 2],\n  \"message\": \"Check out these photos!\"\n}"
            },
            "url": "{{baseUrl}}/shares"
          }
        },
        {
          "name": "Share via Email",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emails\": [\"someone@example.com\"],\n  \"photo_ids\": [1, 2],\n  \"message\": \"Check out these photos!\"\n}"
            },
            "url": "{{baseUrl}}/shares/email"
          }
        }
      ]
    },
    {
      "name": "Share Links",
      "item": [
        {
          "name": "List Share Links",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/share-links"
          }
        },
        {
          "name": "Create Share Link",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"photo\",\n  \"id\": 1,\n  \"expires_in_days\": 7\n}"
            },
            "url": "{{baseUrl}}/share-links"
          }
        },
        {
          "name": "Delete Share Link",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/share-links/1"
          }
        },
        {
          "name": "View Shared Content (Public)",
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/share/TOKEN_HERE"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/notifications"
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/notifications/unread-count"
          }
        },
        {
          "name": "Mark as Read",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/notifications/1/read"
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Name\",\n  \"email\": \"newemail@example.com\"\n}"
            },
            "url": "{{baseUrl}}/profile"
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password123\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
            },
            "url": "{{baseUrl}}/profile/password"
          }
        },
        {
          "name": "Update Avatar",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "avatar", "type": "file", "src": ""}
              ]
            },
            "url": "{{baseUrl}}/profile/avatar"
          }
        },
        {
          "name": "Get Storage Info",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{baseUrl}}/profile/storage"
          }
        }
      ]
